{
	"manifest_version": 2.0,
	"id": "service-tree",
	"name": "Service tree",
	"version": "1.2.0",
	"namespace": "ServiceTree",
	"author": "Service tree module contributors",
	"description": "Expandable service tree with SLA bars, status timeline and SLI-per-period graphs.",
	"actions": {
		"servicetree.list": {
			"class": "ServiceTreeList",
			"view": "servicetree.list",
			"layout": "layout.htmlpage"
		},
		"servicetree.list.sla": {
			"class": "ServiceTreeListSla",
			"layout": "layout.json"
		},
		"servicetree.popup": {
			"class": "ServiceTreePopup",
			"view": "servicetree.popup",
			"layout": "layout.json"
		},
		"servicetree.popup.data": {
			"class": "ServiceTreePopupData",
			"layout": "layout.json"
		}
	},
	"assets": {
		"css": [
			"servicetree.css"
		],
		"js": [
			"servicetree.popup.js"
		]
	},
	"config": {
		"cache_ttl": 60,
		"problem_lookback_days": 7,
		"max_problems": 50,
		"problems_per_page": 20,
		"max_problem_services": 1000,
		"tags_per_query": 100
	},
	"url": "https://github.com/<your-account>/zabbix-module-service-tree"
}
